{
	"name": "steam-tierlister",
	"version": "0.0.0",
	"private": true,
	"description": "Millennium plugin: TierMaker-style tier lists for your Steam library, inside the Steam client.",
	"license": "MIT",
	"author": "Nicholas Laurion",
	"repository": {
		"type": "git",
		"url": "https://github.com/TilledSwing/steam-tierlister.git"
	},
	"type": "module",
	"scripts": {
		"prepare": "starlight lsp",
		"dev": "starlight watch",
		"build": "starlight pack",
		"build:ci": "bun -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && starlight pack --of dist",
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@steambrew/starlight": "1.1.7",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	}
}
